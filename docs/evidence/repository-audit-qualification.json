      "source": "import importlib.metadata\nimport io\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport unittest\n\nmode, root, report_path = sys.argv[1], Path(sys.argv[2]).resolve(), Path(sys.argv[3])\nif mode != \"wheel\":\n    sys.path.insert(0, str(root / \"src\"))\nimport mindgarden\n\nengine = Path(mindgarden.__file__).resolve()\nif mode == \"wheel\":\n    expected = Path(sys.prefix).resolve()\n    assert engine.is_relative_to(expected)\n    inventory = sorted(item.metadata[\"Name\"] for item in importlib.metadata.distributions())\n    assert inventory == [\"mindgarden\"], inventory\nelse:\n    expected = root / \"src\"\n    assert engine.is_relative_to(expected)\n    inventory = \"site-disabled\"\nsys.path.insert(0, str(root))\ncases = [\n    \"tests.test_packet_freshness.PacketFreshnessTests.test_corrected_selected_source_requires_new_review_and_preserves_prior_packet\",\n    \"tests.test_packet_freshness.PacketFreshnessTests.test_existing_packet_verification_survives_session_renewal_without_writes\",\n    \"tests.test_packet_freshness.PacketFreshnessTests.test_missing_or_corrupted_current_evidence_blocks_reuse_and_preserves_bundle\",\n    \"tests.test_drive_normalization.DriveNormalizationTests.test_layouts_overlap_and_every_provider_occurrence_keep_exact_original_spans\",\n    \"tests.test_drive_normalization.DriveNormalizationTests.test_changed_configuration_rejects_old_apply_before_any_additional_vault_write\",\n    \"tests.test_drive_normalization.DriveNormalizationTests.test_clean_vault_restore_and_removed_mapping_filename_preserve_packet_and_dependencies\",\n    \"tests.test_rendered_federation.RenderedFederationTests.test_historical_only_assertions_cannot_change_current_public_metadata\",\n    \"tests.test_archive_continuation.ArchiveContinuationTests.test_import_keeps_continuation_unreviewed_and_never_creates_knowledge\",\n]\nreport_path.with_suffix(\".progress.json\").write_text(json.dumps({\"mode\":mode,\"state\":\"running\",\"cases\":len(cases)}))\nstart = time.monotonic()\nstream = sys.stdout\nresult = unittest.TextTestRunner(stream=stream, verbosity=1).run(unittest.defaultTestLoader.loadTestsFromNames(cases))\nif not result.wasSuccessful() or result.skipped:\n    raise SystemExit(1)\norigins = [Path(module.__file__).resolve() for name, module in sys.modules.items()\n           if name.startswith(\"mindgarden\") and getattr(module, \"__file__\", None)]\nassert origins and all(path.is_relative_to(expected) for path in origins), origins\nreport = {\"mode\":mode, \"interpreter\":sys.executable, \"engine\":str(engine),\n          \"distributions\":inventory, \"tests\":result.testsRun, \"skipped\":len(result.skipped),\n          \"test_seconds\":round(time.monotonic()-start,3), \"cases\":cases, \"verified_module_origins\":len(origins), \"proofs\":[]}\nfor script, has_golden_flag in ((\"consultation_demo.py\",True),(\"mapped_drive_consultation_demo.py\",True),(\"garden_reference_demo.py\",False)):\n    workspace = tempfile.mkdtemp(prefix=\"mindgarden-audit-\"+mode+\"-\", dir=\"/var/tmp\")\n    command = [sys.executable, \"-I\" if mode == \"wheel\" else \"-S\", str(root / \"scripts\" / script),\n               \"--workspace\",workspace,\"--require-installed\" if mode == \"wheel\" else \"--require-source\"]\n    if has_golden_flag:\n        command.append(\"--check-golden\")\n    begin = time.monotonic()\n    proof = subprocess.run(command, capture_output=True, text=True)\n    if proof.returncode:\n        print(proof.stdout[-6000:]+proof.stderr[-6000:])\n        raise SystemExit(proof.returncode)\n    from hashlib import sha256\n    report[\"proofs\"].append({\"command\":command,\"returncode\":proof.returncode,\n        \"seconds\":round(time.monotonic()-begin,3),\"report_sha256\":sha256(proof.stdout.encode()).hexdigest()})\nreport_path.write_text(json.dumps(report,indent=2)+\"\\n\")\nreport_path.with_suffix(\".progress.json\").write_text(json.dumps({\"mode\":mode,\"state\":\"passed\",\"tests\":report[\"tests\"]}))\nprint(json.dumps({\"mode\":mode,\"tests\":report[\"tests\"],\"skipped\":report[\"skipped\"],\n                  \"test_seconds\":report[\"test_seconds\"],\"proofs\":len(report[\"proofs\"]),\n                  \"verified_module_origins\":len(origins),\"status\":\"passed\"}))\n"
