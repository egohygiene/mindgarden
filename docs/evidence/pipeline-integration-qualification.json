  "runner_sources": {
    "integration-boundary.py": "import importlib.metadata\nimport json\nfrom pathlib import Path\nimport sys\nimport time\nimport unittest\nmode, root, report_path = sys.argv[1], Path(sys.argv[2]).resolve(), Path(sys.argv[3])\nif mode != 'wheel':\n sys.path.insert(0,str(root/'src'))\nimport mindgarden\nexpected = Path(sys.prefix).resolve() if mode=='wheel' else root/'src'\nassert Path(mindgarden.__file__).resolve().is_relative_to(expected)\nif mode=='wheel':\n distributions=sorted(item.metadata['Name'] for item in importlib.metadata.distributions())\n assert distributions==['mindgarden'],distributions\nelse:\n distributions='site-disabled'\nsys.path.insert(0,str(root))\nmodules=['tests.test_archive_delivery','tests.test_query_store_evolution','tests.test_decision_relationships','tests.test_standalone_integration','tests.test_private_garden_workflow']\nstarted=time.monotonic()\nresult=unittest.TextTestRunner(stream=sys.stdout,verbosity=1).run(unittest.defaultTestLoader.loadTestsFromNames(modules))\nif not result.wasSuccessful() or result.skipped:\n raise SystemExit(1)\norigins=[Path(module.__file__).resolve() for name,module in sys.modules.items() if name.startswith('mindgarden') and getattr(module,'__file__',None)]\nassert origins and all(path.is_relative_to(expected) for path in origins),origins\nreport={'mode':mode,'tests':result.testsRun,'skipped':len(result.skipped),'seconds':round(time.monotonic()-started,3),'modules':modules,'verified_module_origins':len(origins),'distributions':distributions,'status':'passed'}\nreport_path.write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps(report),flush=True)\n",
    "integration-focused.py": "import json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport time\n\nroot, interpreter, label = Path(sys.argv[1]), sys.argv[2], sys.argv[3]\nmodules = ['tests.test_archive_delivery', 'tests.test_archive_continuation', 'tests.test_archive_v2', 'tests.test_conversation_archives', 'tests.test_archive_selection', 'tests.test_archive_diagrams', 'tests.test_query_store_evolution', 'tests.test_query_store', 'tests.test_decision_relationships', 'tests.test_decisions', 'tests.test_v1_contracts', 'tests.test_v1_retrieval', 'tests.test_scope_bundle_outputs', 'tests.test_scoped_retrieval', 'tests.test_source_adapters', 'tests.test_standalone_integration', 'tests.test_private_garden_workflow', 'tests.test_mixed_vault_workflow', 'tests.test_release_journey', 'tests.test_compaction', 'tests.test_pipeline_completion', 'tests.test_reading_journey']\ndirectory = root / \".cache/integration-qualification\"\ndirectory.mkdir(parents=True, exist_ok=True)\nrevision = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=root, text=True).strip()\nreport = {\"revision\":revision,\"interpreter\":interpreter,\"modules\":[],\"complete\":False}\npath = directory / (label+\".json\")\nstart=time.monotonic()\nfor module in modules:\n    command=[interpreter,\"-m\",\"unittest\",module,\"--verbose\"]\n    begin=time.monotonic()\n    log_path=directory/(label+\"-\"+module.split(\".\")[-1]+\".log\")\n    output=[]\n    with log_path.open(\"w\") as log:\n        process=subprocess.Popen(command,cwd=root,env={**os.environ,\"PYTHONPATH\":str(root/\"src\")},stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1)\n        for line in process.stdout:\n            log.write(line);log.flush();output.append(line)\n        returncode=process.wait()\n    text=\"\".join(output)\n    match=re.search(r\"Ran (\\d+) tests? in ([\\d.]+)s\",text)\n    entry={\"module\":module,\"command\":command,\"returncode\":returncode,\n           \"tests\":int(match[1]) if match else None,\"seconds\":round(time.monotonic()-begin,3),\n           \"unittest_seconds\":float(match[2]) if match else None,\"skipped\":\"skipped=\" in text}\n    report[\"modules\"].append(entry)\n    report[\"wall_seconds\"]=round(time.monotonic()-start,3)\n    path.write_text(json.dumps(report,indent=2)+\"\\n\")\n    print(json.dumps({\"label\":label,**entry}),flush=True)\n    if returncode or entry[\"skipped\"]:\n        print(text[-18000:],flush=True)\n        raise SystemExit(1)\nreport.update(complete=True,tests=sum(item[\"tests\"] for item in report[\"modules\"]),\n              skipped=0,returncode=0)\npath.write_text(json.dumps(report,indent=2)+\"\\n\")\nprint(json.dumps({\"label\":label,\"complete\":True,\"tests\":report[\"tests\"],\"wall_seconds\":report[\"wall_seconds\"]}),flush=True)\n"
  },
