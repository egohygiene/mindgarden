{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:garden:v0",
  "title": "Mindgarden garden manifest v0",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "status",
    "owners",
    "repository",
    "visibility",
    "entrypoint",
    "content_roots",
    "generated_roots",
    "provenance_root",
    "context_pack_root",
    "private_overlay"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.garden/v0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["incubating", "active", "deprecated", "archived"]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "visibility": {
      "enum": ["public", "internal", "private"]
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^/].*\\.md$"
    },
    "content_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_root": {
      "type": "string",
      "minLength": 1
    },
    "context_pack_root": {
      "type": "string",
      "minLength": 1
    },
    "private_overlay": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
