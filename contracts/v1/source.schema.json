{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:source:v1",
  "title": "Mindgarden captured or normalized source v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "garden",
    "title",
    "kind",
    "status",
    "visibility",
    "owners",
    "authors",
    "review",
    "origin",
    "captured_at",
    "media_type",
    "rights",
    "artifact",
    "inputs",
    "provenance",
    "publication"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.source/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "garden": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "title": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
    },
    "kind": {
      "enum": [
        "captured",
        "normalized"
      ]
    },
    "status": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/lifecycleStatus"
    },
    "visibility": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/visibility",
      "default": "private"
    },
    "owners": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/owners"
    },
    "authors": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/authors"
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "media_type": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/mediaType"
    },
    "rights": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReferences"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
      }
    },
    "publication": {
      "enum": [
        "excluded",
        "eligible"
      ],
      "default": "excluded"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "captured"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "maxItems": 0
          },
          "publication": {
            "const": "excluded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "normalized"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "const": "eligible"
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "visibility": {
            "const": "public"
          },
          "review": {
            "properties": {
              "state": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ],
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false
}
