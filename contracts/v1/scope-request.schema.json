{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:scope-request:v1",
  "type": "object",
  "required": [
    "schema",
    "operation",
    "scopes"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.scope-request/v1"
    },
    "operation": {
      "enum": [
        "read",
        "query",
        "write",
        "route",
        "export",
        "declassify"
      ]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "urn:egohygiene:mindgarden:scope:v1"
      }
    },
    "destination": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "authority": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
