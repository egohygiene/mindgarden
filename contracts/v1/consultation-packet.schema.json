{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:consultation-packet:v1",
  "title": "Mindgarden private calculation and evidence packet v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mindgarden.consultation-packet/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "review_authority": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/author"
    },
    "calculation": {
      "type": "object",
      "properties": {
        "method": {
          "const": "signed-decimal-movement/v1"
        },
        "precision": {
          "const": 40
        },
        "request_sha256": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
        }
      },
      "required": [
        "method",
        "precision",
        "request_sha256"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "net_movement": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,6})?$"
          },
          "income": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,6})?$"
          },
          "expense": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,6})?$"
          },
          "refund": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,6})?$"
          },
          "transfer": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,6})?$"
          },
          "uncategorized": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,6})?$"
          }
        },
        "required": [
          "month",
          "currency",
          "net_movement",
          "income",
          "expense",
          "refund",
          "transfer",
          "uncategorized"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1200
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "observed_first": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "observed_last": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "missing_declared_intervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date"
                },
                "end": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "status": {
            "enum": [
              "no-supplied-transactions",
              "transactions-present-coverage-unverified"
            ]
          }
        },
        "required": [
          "account",
          "observed_first",
          "observed_last",
          "missing_declared_intervals",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "declared_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "account",
          "start",
          "end",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row": {
            "$ref": "urn:egohygiene:mindgarden:ledger-row:v1"
          },
          "evidence": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sourceLocator"
          },
          "original": {
            "type": "object"
          },
          "classification": {
            "type": "object",
            "properties": {
              "transaction": {
                "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
              },
              "category": {
                "enum": [
                  "income",
                  "expense",
                  "refund",
                  "transfer",
                  "uncategorized"
                ]
              },
              "paired_with": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "transaction",
              "category",
              "paired_with",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "row",
          "evidence",
          "original",
          "classification"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sourceLocator"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 32
    },
    "unresolved_transactions": {
      "type": "array",
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "represented_revision_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transaction": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "source": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "transaction",
          "source",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "schema",
    "id",
    "created_at",
    "period",
    "scope",
    "review",
    "review_authority",
    "calculation",
    "totals",
    "coverage",
    "declared_coverage",
    "transactions",
    "evidence",
    "questions",
    "unresolved_transactions",
    "represented_revision_choices",
    "limitations"
  ],
  "additionalProperties": false
}
