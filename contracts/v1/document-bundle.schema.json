{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:document-bundle:v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "original",
    "scope",
    "classification_sha256",
    "parser",
    "pages",
    "attachments",
    "losses",
    "trust",
    "classification"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.document-bundle/v1"
    },
    "status": {
      "const": "complete"
    },
    "original": {
      "type": "object",
      "required": [
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "const": "application/pdf"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "classification_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parser": {
      "type": "object",
      "required": [
        "name",
        "adapter_version",
        "tools",
        "normalization",
        "limits"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "const": "1.0.0"
        },
        "tools": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "name",
              "version",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "normalization": {
          "const": "word-order-space-separated-lines-lf/1"
        },
        "limits": {
          "type": "object",
          "required": [
            "capture_bytes",
            "output_bytes",
            "timeout_seconds",
            "pages",
            "words"
          ],
          "properties": {
            "capture_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "pages": {
              "type": "integer",
              "minimum": 1
            },
            "words": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "page",
          "normalized_sha256",
          "word_count"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "normalized_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "word_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "attachments": {
      "const": "preserved-in-original-only"
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust": {
      "const": "untrusted-evidence"
    },
    "classification": {
      "$ref": "urn:egohygiene:mindgarden:document-classification:v1"
    }
  },
  "additionalProperties": false
}
