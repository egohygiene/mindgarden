{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:ledger-csv-mapping:v1",
  "title": "Explicit reviewed CSV normalization mapping",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "header",
    "fields",
    "amount",
    "date_format",
    "date_semantics",
    "review_authority",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.ledger-csv-mapping/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "version": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/semanticVersion"
    },
    "header": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "required": [
        "transaction_id",
        "account_id",
        "date",
        "currency",
        "description"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "account_id": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "column"
              ],
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "currency": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "column"
              ],
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "amount": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "column"
          ],
          "properties": {
            "mode": {
              "const": "signed"
            },
            "column": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "debit_column",
            "credit_column"
          ],
          "properties": {
            "mode": {
              "const": "debit-credit"
            },
            "debit_column": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "credit_column": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "date_format": {
      "enum": [
        "YYYY-MM-DD",
        "MM/DD/YYYY"
      ]
    },
    "date_semantics": {
      "enum": [
        "posted-calendar-date",
        "transaction-calendar-date"
      ]
    },
    "review_authority": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "human"
        },
        "id": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    }
  },
  "additionalProperties": false
}
