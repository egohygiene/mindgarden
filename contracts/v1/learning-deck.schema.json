{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:learning-deck:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "objective"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.learning-deck/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
