{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:evidence:v1",
  "title": "Mindgarden exact authorized evidence v1",
  "type": "object",
  "required": [
    "schema",
    "source",
    "locator",
    "content_sha256",
    "trust",
    "text",
    "source_identity",
    "source_review",
    "scope",
    "origin",
    "lineage",
    "authorized_by"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.evidence/v1"
    },
    "source": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "trust": {
      "const": "untrusted-evidence"
    },
    "text": {
      "type": "string"
    },
    "source_identity": {
      "type": "string",
      "minLength": 1
    },
    "source_review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "origin": {
      "type": "object"
    },
    "lineage": {
      "type": "array",
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
      }
    },
    "authorized_by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "reference",
          "review"
        ],
        "properties": {
          "reference": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
          },
          "review": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
          }
        },
        "additionalProperties": false
      }
    },
    "authorization": {
      "const": "session-source-grant"
    }
  },
  "additionalProperties": false
}
