{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:memory-validity:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "classification",
    "publication",
    "scope",
    "authority_sha256",
    "request_sha256",
    "retention_sha256",
    "projection_sha256",
    "markdown_sha256",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.memory-validity/v1"
    },
    "classification": {
      "const": "machine-local-control"
    },
    "publication": {
      "const": "never-exportable"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "authority_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "request_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "retention_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "projection_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "markdown_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
