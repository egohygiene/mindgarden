{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:common:v1",
  "title": "Mindgarden common contract definitions v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "externalOverlayPath": {
      "type": "string",
      "pattern": "^\\.\\./(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "visibility": {
      "enum": [
        "public",
        "internal",
        "private"
      ]
    },
    "lifecycleStatus": {
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "archived"
      ]
    },
    "confidence": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "epistemicState": {
      "enum": [
        "observed",
        "decided",
        "inferred",
        "proposed",
        "assumed",
        "unverified",
        "open-question"
      ]
    },
    "identifierSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "author": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "state",
        "reviewers",
        "reviewed_at",
        "rationale"
      ],
      "properties": {
        "state": {
          "enum": [
            "unreviewed",
            "in-review",
            "approved",
            "rejected"
          ],
          "default": "unreviewed"
        },
        "reviewers": {
          "$ref": "#/$defs/identifierSet"
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unreviewed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reviewers": {
                "maxItems": 0
              },
              "reviewed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reviewers": {
                "minItems": 1
              },
              "reviewed_at": {
                "type": "string"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "immutableRevision": {
      "type": "string",
      "pattern": "^(?:git:[0-9a-f]{40}|sha256:[0-9a-f]{64}|version:1\\.[0-9]+\\.[0-9]+)$"
    },
    "gardenReference": {
      "type": "object",
      "required": [
        "id",
        "canonical_uri",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "canonical_uri": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/immutableRevision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "artifactReference": {
      "type": "object",
      "required": [
        "garden",
        "id"
      ],
      "properties": {
        "garden": {
          "$ref": "#/$defs/identifier"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/immutableRevision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "artifactReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "sourceLocator": {
      "type": "object",
      "required": [
        "source",
        "locator",
        "content_sha256"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/artifactReference"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "extensionProperties": {
      "type": "object",
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    }
  }
}
