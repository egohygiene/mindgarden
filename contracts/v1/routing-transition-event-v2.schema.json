{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:routing-transition-event:v2",
  "type": "object",
  "required": [
    "request_sha256",
    "from",
    "to",
    "operation",
    "review",
    "authority",
    "rationale",
    "schema"
  ],
  "properties": {
    "request_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "from": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
    },
    "to": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
    },
    "operation": {
      "enum": [
        "move",
        "merge",
        "split",
        "supersede"
      ]
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "authority": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "human"
        },
        "id": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "mindgarden.routing-transition-event/v2"
    },
    "split_targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "split"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "split_targets"
        ]
      },
      "else": {
        "not": {
          "required": [
            "split_targets"
          ]
        }
      }
    }
  ]
}
