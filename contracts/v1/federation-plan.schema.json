{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:federation-plan:v1",
  "title": "Mindgarden federation-plan v1",
  "type": "object",
  "required": [
    "schema",
    "reviewed_profile_sha256",
    "authority_sha256",
    "destination_sha256",
    "descriptor_revision",
    "files",
    "plan_sha256"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.federation-plan/v1"
    },
    "reviewed_profile_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "authority_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "destination_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "descriptor_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "urn:egohygiene:mindgarden:federation-descriptor:v1#/$defs/file"
      },
      "uniqueItems": true
    },
    "plan_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    }
  },
  "additionalProperties": false
}
