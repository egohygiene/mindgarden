{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:knowledge:v1",
  "title": "Mindgarden durable knowledge metadata v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "garden",
    "title",
    "kind",
    "status",
    "confidence",
    "visibility",
    "owners",
    "authors",
    "review",
    "created",
    "updated",
    "domains",
    "topics",
    "aliases",
    "tags",
    "content",
    "sources",
    "claims",
    "synapses",
    "provenance",
    "supersedes",
    "publication"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.knowledge/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "garden": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "title": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
    },
    "kind": {
      "enum": [
        "map",
        "concept",
        "decision",
        "project",
        "procedure",
        "insight",
        "reference",
        "note"
      ]
    },
    "status": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/lifecycleStatus",
      "default": "proposed"
    },
    "confidence": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/confidence",
      "default": "unknown"
    },
    "visibility": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/visibility",
      "default": "private"
    },
    "owners": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/owners"
    },
    "authors": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/authors"
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "domains": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/domains"
    },
    "topics": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/topics"
    },
    "aliases": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/stringSet"
    },
    "tags": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifierSet"
    },
    "content": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
        },
        "sha256": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sourceLocator"
      }
    },
    "claims": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReferences"
    },
    "synapses": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReferences"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
      }
    },
    "supersedes": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReferences"
    },
    "publication": {
      "enum": [
        "excluded",
        "eligible"
      ],
      "default": "excluded"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication": {
            "const": "eligible"
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "visibility": {
            "const": "public"
          },
          "status": {
            "const": "active"
          },
          "review": {
            "properties": {
              "state": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ],
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false
}
