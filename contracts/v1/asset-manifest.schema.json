{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:asset-manifest:v1",
  "type": "object",
  "required": [
    "schema",
    "publication",
    "scope",
    "selection",
    "assets",
    "source_revisions",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.asset-manifest/v1"
    },
    "publication": {
      "const": "never-exportable"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "selection": {
      "const": "explicit-assets-projection-and-source-review-grants"
    },
    "assets": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "content_id",
          "sha256",
          "size_bytes",
          "media_types",
          "origins",
          "rights",
          "sources",
          "provenance",
          "scope",
          "state",
          "review",
          "retention",
          "copy_policy",
          "encryption",
          "interpretation"
        ],
        "properties": {
          "content_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
            }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
            }
          },
          "scope": {
            "$ref": "urn:egohygiene:mindgarden:scope:v1"
          },
          "state": {
            "enum": [
              "unreviewed",
              "keep",
              "useful-reference",
              "duplicate",
              "low-quality",
              "discard-proposed",
              "restricted",
              "archived"
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "event",
                  "authority",
                  "review"
                ],
                "properties": {
                  "event": {
                    "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
                  },
                  "authority": {
                    "type": "object",
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "human"
                      },
                      "id": {
                        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
                      }
                    },
                    "additionalProperties": false
                  },
                  "review": {
                    "allOf": [
                      {
                        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
                      },
                      {
                        "properties": {
                          "state": {
                            "const": "approved"
                          }
                        }
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "retention": {
            "type": "object",
            "required": [
              "policy",
              "legal_hold",
              "delete_authority"
            ],
            "properties": {
              "policy": {
                "const": "retain-originals"
              },
              "legal_hold": {
                "type": "boolean"
              },
              "delete_authority": {
                "const": "none"
              }
            },
            "additionalProperties": false
          },
          "copy_policy": {
            "const": "reference-only"
          },
          "encryption": {
            "type": "object",
            "required": [
              "required",
              "verified"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "verified": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "interpretation": {
            "const": "untrusted-source"
          }
        },
        "additionalProperties": false
      }
    },
    "source_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "garden",
          "revision"
        ],
        "properties": {
          "garden": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "manifest_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    }
  },
  "additionalProperties": false
}
