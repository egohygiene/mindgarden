{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:learning-review-event:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "item",
    "item_revision",
    "reviewed_at",
    "reviewed_by",
    "grade",
    "scheduler",
    "previous_event"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.learning-review-event/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "item": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "item_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "grade": {
      "enum": [
        "again",
        "hard",
        "good",
        "easy"
      ]
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "previous_event": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
