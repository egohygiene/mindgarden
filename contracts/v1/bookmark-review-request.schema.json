{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:bookmark-review-request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_sha256",
    "catalog_sha256",
    "prior_receipt_sha256",
    "policy",
    "review",
    "review_authority",
    "offset",
    "limit",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.bookmark-review-request/v1"
    },
    "source_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "catalog_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "prior_receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/immutableRevision"
        }
      }
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "review_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "human"
        },
        "id": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
        }
      }
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "urn:egohygiene:mindgarden:bookmark-decision:v1"
      }
    }
  }
}
