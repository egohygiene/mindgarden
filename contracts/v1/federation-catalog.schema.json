{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:federation-catalog:v1",
  "title": "Mindgarden federation-catalog v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "trust",
    "scope",
    "gardens",
    "records",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.federation-catalog/v1"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "trust": {
      "const": "untrusted-evidence"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:federation-descriptor:v1#/$defs/public_scope"
    },
    "gardens": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "garden",
          "canonical_uri",
          "base_uri",
          "revision",
          "descriptor_sha256"
        ],
        "properties": {
          "garden": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "canonical_uri": {
            "type": "string",
            "format": "uri"
          },
          "base_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2000
          },
          "revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "descriptor_sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "reference",
          "canonical_url",
          "title",
          "kind",
          "review_state"
        ],
        "properties": {
          "reference": {
            "$ref": "urn:egohygiene:mindgarden:federation-descriptor:v1#/$defs/artifact"
          },
          "canonical_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2000
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "review_state": {
            "const": "approved"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "enum": [
          "FEDERATION_UNAVAILABLE",
          "FEDERATION_INVALID",
          "FEDERATION_VERSION",
          "FEDERATION_INTEGRITY",
          "FEDERATION_STALE",
          "FEDERATION_DUPLICATE_ID",
          "FEDERATION_CANONICAL_CONFLICT",
          "FEDERATION_BUDGET"
        ]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
