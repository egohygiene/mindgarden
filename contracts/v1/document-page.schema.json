{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:document-page:v1",
  "type": "object",
  "required": [
    "schema",
    "original_sha256",
    "page",
    "width",
    "height",
    "text",
    "words"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.document-page/v1"
    },
    "original_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "width": {
      "type": "number",
      "minimum": 0.000001,
      "maximum": 100000
    },
    "height": {
      "type": "number",
      "minimum": 0.000001,
      "maximum": 100000
    },
    "text": {
      "type": "string"
    },
    "words": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "text",
          "bbox",
          "start_byte",
          "end_byte"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
