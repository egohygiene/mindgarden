{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:adr-projection:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "visibility",
    "represented_commit",
    "source_contract",
    "authority",
    "nodes",
    "edges",
    "backlinks",
    "context"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.adr-projection/v1"
    },
    "visibility": {
      "const": "public"
    },
    "represented_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_contract": {
      "const": "egohygiene.observatory.repository-intelligence-read-model/v1"
    },
    "authority": {
      "const": "upstream-assertions-only"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "title",
          "source",
          "represented_commit",
          "status",
          "decision_scope",
          "implementation_status",
          "assertion",
          "visibility",
          "review",
          "narrative",
          "approval",
          "owners",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "represented_commit": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "decision_scope": {
            "type": "string"
          },
          "implementation_status": {
            "type": "string"
          },
          "assertion": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "review": {
            "type": "string"
          },
          "narrative": {
            "type": "string"
          },
          "approval": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "by",
                  "date",
                  "evidence"
                ],
                "properties": {
                  "by": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "evidence": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            ]
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9.-]+$"
          },
          "authority_scope": {
            "enum": [
              "repository-local",
              "organization-scope-reference",
              "cross-repository-reference"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "type",
          "assertion"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "enum": [
              "supersedes",
              "superseded-by",
              "amends",
              "depends-on",
              "conflicts-with",
              "related-to",
              "blocks",
              "evidences",
              "implements",
              "informs",
              "tracks",
              "verifies"
            ]
          },
          "assertion": {
            "enum": [
              "authoritative",
              "inferred"
            ]
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "revision",
                "observed_at",
                "assertion",
                "freshness"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "format": "uri"
                },
                "revision": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  ]
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "assertion": {
                  "enum": [
                    "authoritative",
                    "inferred"
                  ]
                },
                "freshness": {
                  "enum": [
                    "current",
                    "not_applicable"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "backlinks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "target",
            "type",
            "assertion"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "type": {
              "enum": [
                "supersedes",
                "superseded-by",
                "amends",
                "depends-on",
                "conflicts-with",
                "related-to",
                "blocks",
                "evidences",
                "implements",
                "informs",
                "tracks",
                "verifies"
              ]
            },
            "assertion": {
              "enum": [
                "authoritative",
                "inferred"
              ]
            },
            "provenance": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "revision",
                  "observed_at",
                  "assertion",
                  "freshness"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "format": "uri"
                  },
                  "revision": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      }
                    ]
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "assertion": {
                    "enum": [
                      "authoritative",
                      "inferred"
                    ]
                  },
                  "freshness": {
                    "enum": [
                      "current",
                      "not_applicable"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "title",
          "status",
          "reason",
          "untrusted"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "untrusted": {
            "const": true
          },
          "decision": {
            "type": "string",
            "format": "uri"
          },
          "relationship": {
            "enum": [
              "blocks",
              "depends-on",
              "evidences",
              "implements",
              "informs",
              "tracks",
              "verifies"
            ]
          },
          "assertion": {
            "enum": [
              "authoritative",
              "inferred"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "related-to-selected-decision"
                }
              }
            },
            "then": {
              "required": [
                "decision",
                "relationship",
                "assertion"
              ]
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "kind",
          "title",
          "repository",
          "source",
          "state",
          "assertion",
          "visibility",
          "observed_in_commit",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "repository",
              "roadmap_step",
              "issue",
              "pull_request",
              "commit",
              "check",
              "release",
              "deployment"
            ]
          },
          "title": {
            "type": "string"
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9.-]+$"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "state": {
            "type": "string"
          },
          "assertion": {
            "enum": [
              "authoritative",
              "inferred"
            ]
          },
          "visibility": {
            "const": "public"
          },
          "observed_in_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "revision",
                "observed_at",
                "assertion",
                "freshness"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "format": "uri"
                },
                "revision": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  ]
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "assertion": {
                  "enum": [
                    "authoritative",
                    "inferred"
                  ]
                },
                "freshness": {
                  "enum": [
                    "current",
                    "not_applicable"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "const": "selected-current-public-inputs-only"
    }
  }
}
