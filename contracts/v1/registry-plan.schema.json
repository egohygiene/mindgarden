{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:registry-plan:v1",
  "title": "Mindgarden registry-plan v1",
  "type": "object",
  "required": [
    "schema",
    "classification",
    "publication",
    "operation",
    "registry_path",
    "before_sha256",
    "after_sha256",
    "request",
    "inputs",
    "changes",
    "plan_sha256"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.registry-plan/v1"
    },
    "classification": {
      "const": "machine-local-control"
    },
    "publication": {
      "const": "never-exportable"
    },
    "operation": {
      "enum": [
        "init",
        "register",
        "unregister",
        "set-view",
        "remove-view",
        "restore"
      ]
    },
    "registry_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "before_sha256": {
      "anyOf": [
        {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "after_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "request": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "maxItems": 101,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "sha256",
          "device",
          "inode"
        ],
        "properties": {
          "kind": {
            "enum": [
              "garden-manifest",
              "registry-snapshot"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          },
          "device": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "inode": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "changes": {
      "type": "array",
      "maxItems": 202,
      "items": {
        "type": "object",
        "required": [
          "entity",
          "id",
          "before",
          "after"
        ],
        "properties": {
          "entity": {
            "enum": [
              "registry",
              "garden",
              "view",
              "revocations"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "plan_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "init"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "type": "object",
            "required": [],
            "properties": {},
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "register"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "type": "object",
            "required": [
              "root",
              "scope",
              "expected_garden",
              "expected_owners"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "scope": {
                "$ref": "urn:egohygiene:mindgarden:scope:v1"
              },
              "expected_garden": {
                "anyOf": [
                  {
                    "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expected_owners": {
                "anyOf": [
                  {
                    "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/owners"
                  },
                  {
                    "const": []
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "unregister"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "type": "object",
            "required": [
              "garden"
            ],
            "properties": {
              "garden": {
                "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-view"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "type": "object",
            "required": [
              "id",
              "gardens"
            ],
            "properties": {
              "id": {
                "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
              },
              "gardens": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "remove-view"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "restore"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "type": "object",
            "required": [
              "revision"
            ],
            "properties": {
              "revision": {
                "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
