{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:federation-catalog-request:v1",
  "title": "Mindgarden federation-catalog-request v1",
  "type": "object",
  "required": [
    "schema",
    "bundles"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.federation-catalog-request/v1"
    },
    "bundles": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "directory",
          "expected_revision"
        ],
        "properties": {
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "format": {
            "enum": [
              "federation-bundle",
              "rendered-site"
            ]
          },
          "expected_manifest_sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "format"
              ],
              "properties": {
                "format": {
                  "const": "rendered-site"
                }
              }
            },
            "then": {
              "required": [
                "expected_manifest_sha256"
              ]
            }
          },
          {
            "if": {
              "required": [
                "expected_manifest_sha256"
              ]
            },
            "then": {
              "required": [
                "format"
              ],
              "properties": {
                "format": {
                  "const": "rendered-site"
                }
              }
            }
          }
        ]
      }
    },
    "previous": {
      "$ref": "urn:egohygiene:mindgarden:federation-catalog:v1"
    }
  },
  "additionalProperties": false
}
