{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:provenance:v1",
  "title": "Mindgarden ordered provenance record v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "garden",
    "artifact",
    "artifact_sha256",
    "origin",
    "inputs",
    "transformations",
    "generator",
    "created_at",
    "rights"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.provenance/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "garden": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "artifact": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
    },
    "artifact_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "origin": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "sha256",
          "role"
        ],
        "properties": {
          "artifact": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
          },
          "sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          },
          "role": {
            "enum": [
              "source",
              "evidence",
              "configuration",
              "previous-version"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "name",
          "version",
          "parameters",
          "performed_by"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "version": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
          },
          "parameters": {
            "type": "object"
          },
          "performed_by": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/author"
          }
        },
        "additionalProperties": false
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
        },
        "version": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rights": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false
}
