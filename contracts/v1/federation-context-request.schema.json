{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:federation-context-request:v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "catalog",
    "bundles",
    "query",
    "max_items",
    "max_bytes"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.federation-context-request/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "catalog": {
      "$ref": "urn:egohygiene:mindgarden:federation-catalog:v1"
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "garden",
          "directory",
          "expected_revision"
        ],
        "properties": {
          "garden": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "query": {
      "type": "string",
      "maxLength": 4096
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 16777216
    }
  },
  "additionalProperties": false
}
