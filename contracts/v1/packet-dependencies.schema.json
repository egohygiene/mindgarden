{
  "$id": "urn:egohygiene:mindgarden:packet-dependencies:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_evidence": {
      "const": false
    },
    "fingerprint": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sourceLocator"
          },
          "metadata_sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          }
        },
        "required": [
          "evidence",
          "metadata_sha256"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inputs_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
          },
          "sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "maxItems": 35,
      "minItems": 3,
      "type": "array"
    },
    "request_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "schema": {
      "const": "mindgarden.packet-dependencies/v1"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    }
  },
  "required": [
    "schema",
    "id",
    "scope",
    "request_sha256",
    "inputs_sha256",
    "inputs",
    "outputs",
    "canonical_evidence",
    "fingerprint"
  ],
  "title": "Private packet dependency comparison metadata v1",
  "type": "object"
}
