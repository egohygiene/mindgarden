{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:consultation-request:v1",
  "title": "Mindgarden reviewed private preparation request v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mindgarden.consultation-request/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "review_authority": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/author"
    },
    "review": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "currencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "required": [
          "code",
          "scale"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sourceLocator"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transaction": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "category": {
            "enum": [
              "income",
              "expense",
              "refund",
              "transfer",
              "uncategorized"
            ]
          },
          "paired_with": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "transaction",
          "category",
          "paired_with",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transaction": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "source": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "transaction",
          "source",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "selection": {
      "type": "array",
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "account",
          "start",
          "end",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 32
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1000000
        }
      },
      "required": [
        "max_rows",
        "max_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "created_at",
    "scope",
    "review_authority",
    "review",
    "period",
    "accounts",
    "currencies",
    "sources",
    "decisions",
    "revisions",
    "selection",
    "attachments",
    "coverage",
    "questions",
    "limits"
  ],
  "additionalProperties": false
}
