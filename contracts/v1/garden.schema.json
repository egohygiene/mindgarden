{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:garden:v1",
  "title": "Mindgarden garden manifest v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "kind",
    "status",
    "visibility",
    "owners",
    "canonical_uri",
    "repository",
    "classification",
    "contracts",
    "roots",
    "private_overlay",
    "publication",
    "routing",
    "migrations"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.garden/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "title": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
    },
    "version": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/semanticVersion"
    },
    "kind": {
      "enum": [
        "repository",
        "personal",
        "organization"
      ]
    },
    "status": {
      "enum": [
        "incubating",
        "active",
        "deprecated",
        "archived"
      ]
    },
    "visibility": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/visibility"
    },
    "owners": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/owners"
    },
    "canonical_uri": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https://"
    },
    "classification": {
      "type": "object",
      "required": [
        "domains",
        "topics"
      ],
      "properties": {
        "domains": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/domains"
        },
        "topics": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/topics"
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "required": [
        "reads",
        "writes"
      ],
      "properties": {
        "reads": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/stringSet"
        },
        "writes": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/stringSet"
        }
      },
      "additionalProperties": false
    },
    "roots": {
      "type": "object",
      "required": [
        "sources",
        "knowledge",
        "provenance",
        "context_packs",
        "generated"
      ],
      "properties": {
        "sources": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
        },
        "knowledge": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
        },
        "provenance": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
        },
        "context_packs": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
        },
        "generated": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
          }
        }
      },
      "additionalProperties": false
    },
    "private_overlay": {
      "anyOf": [
        {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/externalOverlayPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "publication": {
      "type": "object",
      "required": [
        "default_action",
        "allowed_visibilities",
        "required_review_states",
        "raw_sources",
        "allow"
      ],
      "properties": {
        "default_action": {
          "const": "deny"
        },
        "allowed_visibilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "public"
          }
        },
        "required_review_states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "approved"
          }
        },
        "raw_sources": {
          "const": "exclude"
        },
        "allow": {
          "type": "object",
          "required": [
            "kinds",
            "domains",
            "topics"
          ],
          "properties": {
            "kinds": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifierSet"
            },
            "domains": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifierSet"
            },
            "topics": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifierSet"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": [
        "domains",
        "topics",
        "private_fallback"
      ],
      "properties": {
        "domains": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/domains"
        },
        "topics": {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/topics"
        },
        "private_fallback": {
          "anyOf": [
            {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/gardenReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "migrations": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReferences"
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false
}
