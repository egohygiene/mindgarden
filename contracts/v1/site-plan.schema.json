{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:site-plan:v1",
  "title": "Mindgarden site-plan v1",
  "type": "object",
  "required": [
    "schema",
    "classification",
    "publication",
    "operation",
    "profile_sha256",
    "authority_sha256",
    "destination_sha256",
    "engine_sha256",
    "revision",
    "renderer",
    "configuration_sha256",
    "files",
    "plan_sha256"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.site-plan/v1"
    },
    "classification": {
      "const": "machine-local-control"
    },
    "publication": {
      "const": "never-exportable"
    },
    "operation": {
      "enum": [
        "project",
        "build"
      ]
    },
    "profile_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "authority_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "destination_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "engine_sha256": {
      "anyOf": [
        {
          "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/immutableRevision"
    },
    "renderer": {
      "$ref": "urn:egohygiene:mindgarden:site-adapter:v1"
    },
    "configuration_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
          },
          "sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16000000
          }
        },
        "additionalProperties": false
      }
    },
    "plan_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    }
  },
  "additionalProperties": false
}
