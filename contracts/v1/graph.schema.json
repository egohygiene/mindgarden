{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:graph:v1",
  "title": "Mindgarden graph projection v1",
  "type": "object",
  "required": [
    "schema",
    "scope",
    "policy",
    "inputs",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.graph/v1"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "policy": {
      "title": "Mindgarden policy-reference v1",
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "garden",
          "revision"
        ],
        "properties": {
          "garden": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "revision": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/immutableRevision"
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference",
          "title",
          "scope",
          "review",
          "sources"
        ],
        "properties": {
          "reference": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
          },
          "title": {
            "type": "string"
          },
          "scope": {
            "$ref": "urn:egohygiene:mindgarden:scope:v1"
          },
          "review": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sourceLocator"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "type",
          "directed",
          "review",
          "scope"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "enum": [
              "related",
              "supports",
              "contradicts",
              "supersedes",
              "derived-from",
              "part-of",
              "depends-on",
              "references"
            ]
          },
          "directed": {
            "type": "boolean"
          },
          "review": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/review"
          },
          "scope": {
            "$ref": "urn:egohygiene:mindgarden:scope:v1"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
