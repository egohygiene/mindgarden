{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:routing-receipt:v1",
  "title": "Mindgarden routing-receipt v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "garden",
    "request_sha256",
    "catalog_sha256",
    "scope",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.routing-receipt/v1"
    },
    "id": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "garden": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
    },
    "request_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "catalog_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "canonical_home",
          "state",
          "confidence",
          "rationale",
          "policy_decisions",
          "rejected_alternatives",
          "references"
        ],
        "properties": {
          "candidate": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
          },
          "canonical_home": {
            "anyOf": [
              {
                "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "routed",
              "private-fallback",
              "unresolved",
              "history-only"
            ]
          },
          "confidence": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/confidence"
          },
          "rationale": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
          },
          "policy_decisions": {
            "type": "array",
            "items": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
            }
          },
          "rejected_alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "garden",
                "reason"
              ],
              "properties": {
                "garden": {
                  "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/identifier"
                },
                "reason": {
                  "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/nonEmptyString"
                }
              },
              "additionalProperties": false
            }
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
            }
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "additionalProperties": false
}
