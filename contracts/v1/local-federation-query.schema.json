              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "operation": {
          "const": "search"
        },
        "query": {
          "type": "string",
          "maxLength": 4000
        },
        "limit": {
          "type": "integer",
