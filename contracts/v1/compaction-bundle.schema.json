{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:compaction-bundle:v1",
  "title": "Mindgarden private compaction proof bundle v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mindgarden.compaction-bundle/v1"
    },
    "classification": {
      "const": "machine-local-control"
    },
    "publication": {
      "const": "never-exportable"
    },
    "scope": {
      "$ref": "urn:egohygiene:mindgarden:scope:v1"
    },
    "input_mode": {
      "enum": [
        "source-grant",
        "reviewed-evidence"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "source_plan_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    },
    "report_sha256": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "classification",
    "publication",
    "scope",
    "input_mode",
    "created_at",
    "expires_at",
    "authority_sha256",
    "source_plan_sha256",
    "manifest_sha256",
    "report_sha256"
  ]
}
