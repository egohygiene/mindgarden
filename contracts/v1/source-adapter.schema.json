{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:source-adapter:v1",
  "title": "Mindgarden explicit captured-source adapter v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "protocol",
    "inputs",
    "limits"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.source-adapter/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "protocol": {
      "const": "captured-bytes/v1"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "media_type",
          "manifest_version"
        ],
        "properties": {
          "media_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.+_-]+/[A-Za-z0-9.+_-]+$"
          },
          "manifest_version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "capture_bytes",
        "units",
        "unit_bytes",
        "normalized_bytes",
        "metadata_bytes"
      ],
      "properties": {
        "capture_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "unit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "normalized_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "metadata_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
