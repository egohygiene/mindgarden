{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:mindgarden:site-manifest:v1",
  "title": "Mindgarden site-manifest v1",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "revision",
    "base_uri",
    "renderer",
    "routes",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "mindgarden.site-manifest/v1"
    },
    "kind": {
      "enum": [
        "content",
        "site"
      ]
    },
    "revision": {
      "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/immutableRevision"
    },
    "base_uri": {
      "type": "string",
      "format": "uri"
    },
    "renderer": {
      "$ref": "urn:egohygiene:mindgarden:site-adapter:v1"
    },
    "routes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "reference",
          "url",
          "path"
        ],
        "properties": {
          "reference": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/artifactReference"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "path": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/portablePath"
          },
          "sha256": {
            "$ref": "urn:egohygiene:mindgarden:common:v1#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16000000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
