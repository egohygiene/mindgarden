# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
# JetBrains-specific templates are maintained separately.
# .idea/

# Mindgarden disposable projections and private overlays
.cache/
.garden.local/

# Python bytecode
__pycache__/
*.py[cod]
